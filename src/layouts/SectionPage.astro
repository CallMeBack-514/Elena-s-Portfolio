---
// The frame of every Section page (spec: section-pages): the Section name as
// the page's only level-1 heading, under the site's BaseLayout.
import BaseLayout from "./BaseLayout.astro";
import type { Language, Section } from "../lib/languages";
import { sectionDescription, sectionName } from "../i18n/ui";

interface Props {
  lang: Language;
  section: Section;
  /** Path after the Language prefix, e.g. "articles/le-devoir/". */
  path: string;
  /** Page title, when it says more than the Section name (an Outlet filter page). */
  title?: string;
}

const { lang, section, path, title } = Astro.props;
const name = sectionName(lang, section);
---

<BaseLayout
  lang={lang}
  path={path}
  title={title ?? name}
  description={sectionDescription(lang, section)}
  section={section}
>
  <div class="wrap section-page">
    <div class="seghead">
      <h1>{name}</h1>
    </div>
    <slot />
  </div>
</BaseLayout>
