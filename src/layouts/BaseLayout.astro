---
// The frame of every Visitor-facing page in one Language: head metadata
// (spec: page-metadata, prelaunch-visibility), the dateline strip with the
// Language switcher and theme toggle, masthead, Section nav and footer.
import "../styles/global.css";
import { Font } from "astro:assets";
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteNav from "../components/SiteNav.astro";
import { LAUNCHED, NAME, SITE_ORIGIN } from "../config/site";
import { LANGUAGES, type Language, type Section } from "../lib/languages";
import { inLang, textBlock } from "../lib/content";

interface Props {
  lang: Language;
  /** Path after the Language prefix, e.g. "" for the Main page. */
  path: string;
  /** Page title; the site name is appended unless this is the Main page. */
  title?: string;
  description?: string;
  /** The Main page: the masthead name is its level-1 heading. Elsewhere it links home. */
  isMain?: boolean;
  /** The Section this page belongs to, marked as current in the nav. */
  section?: Section;
}

const { lang, path, title, description, isMain = false, section } = Astro.props;
const site = await textBlock("site");

const pageTitle = title ? `${title} · ${NAME}` : `${NAME} · ${inLang(site.tagline, lang)}`;
const pageDescription = description ?? inLang(site.description, lang);
const urlFor = (l: Language) => `${SITE_ORIGIN}/${l}/${path}`;
const OG_LOCALE: Record<Language, string> = { fr: "fr_CA", en: "en_CA", it: "it_IT" };
---

<!doctype html>
<html lang={lang}>
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!LAUNCHED && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={urlFor(lang)} />
    {LANGUAGES.map((l) => (
      <link rel="alternate" hreflang={l} href={urlFor(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${SITE_ORIGIN}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGUAGES.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:image" content={`${SITE_ORIGIN}/og-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${NAME} · ${site.location.value}`} />
    <Font cssVariable="--font-mast" preload />
    <Font cssVariable="--font-serif" preload={[{ weight: "400", style: "normal" }]} />
    <Font cssVariable="--font-sans" />
  </head>
  <body>
    <header>
      <div class="strip">
        <div class="wrap">
          <span>{site.location.value}</span>
          <div class="strip-tools">
            <LanguageSwitcher lang={lang} path={path} />
            <ThemeToggle lang={lang} />
          </div>
        </div>
      </div>
      <div class="mast">
        <div class="wrap">
          {isMain ? (
            <h1>{NAME}</h1>
          ) : (
            <p class="mast-name">
              <a href={`/${lang}/`}>{NAME}</a>
            </p>
          )}
          <p class="motto">{inLang(site.tagline, lang)}</p>
        </div>
      </div>
    </header>
    <SiteNav lang={lang} current={section} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
