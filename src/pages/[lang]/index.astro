---
// The Main page, one per Language (spec: main-page): Elena's portrait and
// Collaborations, then one block per Section, in nav order: a Preview of
// Cards with "Tout voir →", the Thèse question, or "coming soon". Contact
// closes the page.
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { LANGUAGES, SECTIONS, type Language } from "../../lib/languages";
import { inLang, preview, textBlock } from "../../lib/content";
import { articleCard } from "../../lib/cards";
import { sectionName, t } from "../../i18n/ui";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const [portrait, collaborations, these, contact] = await Promise.all([
  textBlock("portrait"),
  textBlock("collaborations"),
  textBlock("these"),
  textBlock("contact"),
]);

const blocks = await Promise.all(
  SECTIONS.map(async (section) => ({
    section,
    name: sectionName(lang, section),
    href: `/${lang}/${section}/`,
    cards: (await preview(section)).map((article) => articleCard(article, lang)),
  })),
);
---

<BaseLayout lang={lang} path="" isMain>
  <div class="wrap front">
    <div class="lead">
      <span class="label">{t(lang, "portrait.heading")}</span>
      <h2>{inLang(portrait.heading, lang)}</h2>
      {portrait.photo && (
        <img
          class="portrait-photo"
          src={portrait.photo.src}
          alt={inLang(portrait.photo.alt, lang)}
        />
      )}
      {portrait.bio.map((paragraph) => (
        <p class="stand">{inLang(paragraph, lang)}</p>
      ))}
      <p class="by">{inLang(portrait.byline, lang)}</p>
    </div>
    <aside aria-labelledby="collaborations-heading">
      <h2 id="collaborations-heading">{t(lang, "collaborations.heading")}</h2>
      <ul>
        {collaborations.items.map((item) => (
          <li>
            <span class="outlet">{item.outlet}</span>
            <span class="role">
              {inLang(item.role, lang)}
              {item.years && `, ${item.years}`}
            </span>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  {blocks.map(({ section, name, href, cards }) => (
    <section id={section} aria-labelledby={`${section}-heading`}>
      <div class="wrap">
        <div class="seghead">
          <h2 id={`${section}-heading`}>{name}</h2>
        </div>
        {section === "these" ? (
          <div class="thesis-preview">
            <blockquote>{inLang(these.question, lang)}</blockquote>
            <a class="more" href={href}>
              {t(lang, "readMore")}
              <span class="visually-hidden"> ({name})</span> →
            </a>
          </div>
        ) : (
          <>
            {cards.length > 0 ? (
              <ul class="cards">
                {cards.map((card) => (
                  <li>
                    <EntryCard card={card} lang={lang} level={3} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="soon">{t(lang, "comingSoon")}</p>
            )}
            <a class="more" href={href}>
              {t(lang, "seeAll")}
              <span class="visually-hidden"> ({name})</span> →
            </a>
          </>
        )}
      </div>
    </section>
  ))}

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="wrap">
      <div class="seghead">
        <h2 id="contact-heading">{t(lang, "contact.heading")}</h2>
      </div>
      <p>
        {t(lang, "contact.email")} <span class="email">{contact.email.value}</span>
      </p>
      <ul>
        {contact.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener">
              {inLang(link.label, lang)} ↗
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
