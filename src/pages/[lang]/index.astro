---
// The Main page, one per Language (spec: main-page). In 2a it holds Elena's
// Text blocks and a "coming soon" place for each Section without content;
// build step 2b adds the Previews and the Section pages.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LANGUAGES, type Language, type Section } from "../../lib/languages";
import { inLang, textBlock } from "../../lib/content";
import { sectionName, t } from "../../i18n/ui";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const [portrait, collaborations, these, contact] = await Promise.all([
  textBlock("portrait"),
  textBlock("collaborations"),
  textBlock("these"),
  textBlock("contact"),
]);

const comingSoon: Section[] = ["articles", "tele", "balados"];
---

<BaseLayout lang={lang} path="">
  <div class="wrap front">
    <div class="lead">
      <span class="label">{t(lang, "portrait.heading")}</span>
      <h2>{inLang(portrait.heading, lang)}</h2>
      {portrait.photo && (
        <img
          class="portrait-photo"
          src={portrait.photo.src}
          alt={inLang(portrait.photo.alt, lang)}
        />
      )}
      {portrait.bio.map((paragraph) => (
        <p class="stand">{inLang(paragraph, lang)}</p>
      ))}
      <p class="by">{inLang(portrait.byline, lang)}</p>
    </div>
    <aside aria-labelledby="collaborations-heading">
      <h2 id="collaborations-heading">{t(lang, "collaborations.heading")}</h2>
      <ul>
        {collaborations.items.map((item) => (
          <li>
            <span class="outlet">{item.outlet}</span>
            <span class="role">
              {inLang(item.role, lang)}
              {item.years && `, ${item.years}`}
            </span>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  {comingSoon.map((section) => (
    <section id={section} aria-labelledby={`${section}-heading`}>
      <div class="wrap">
        <div class="seghead">
          <h2 id={`${section}-heading`}>{sectionName(lang, section)}</h2>
        </div>
        <p class="soon">{t(lang, "comingSoon")}</p>
      </div>
    </section>
  ))}

  <section id="these" aria-labelledby="these-heading">
    <div class="wrap">
      <div class="seghead">
        <h2 id="these-heading">{sectionName(lang, "these")}</h2>
        <span class="tc">{inLang(these.programme, lang)}</span>
      </div>
      <div class="thesis">
        <div>
          <blockquote>{inLang(these.question, lang)}</blockquote>
          <p class="lede">{inLang(these.summary, lang)}</p>
        </div>
        <dl class="facts">
          <dt>{t(lang, "these.terrain")}</dt>
          <dd>{inLang(these.terrain, lang)}</dd>
          <dt>{t(lang, "these.cadre")}</dt>
          <dd>{inLang(these.cadre, lang)}</dd>
          <dt>{t(lang, "these.livrable")}</dt>
          <dd>{inLang(these.livrable, lang)}</dd>
          <dt>{t(lang, "these.soutenance")}</dt>
          <dd>{inLang(these.soutenance, lang)}</dd>
        </dl>
      </div>
    </div>
  </section>

  <section id="art" aria-labelledby="art-heading">
    <div class="wrap">
      <div class="seghead">
        <h2 id="art-heading">{sectionName(lang, "art")}</h2>
      </div>
      <p class="soon">{t(lang, "comingSoon")}</p>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-heading">
    <div class="wrap">
      <div class="seghead">
        <h2 id="contact-heading">{t(lang, "contact.heading")}</h2>
      </div>
      <p>
        {t(lang, "contact.email")} <span class="email">{contact.email.value}</span>
      </p>
      <ul>
        {contact.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener">
              {inLang(link.label, lang)} ↗
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
