---
// Section pages with no Entries yet (spec: section-pages): Télé, Balados and
// Art say "coming soon" until 2b-2 gives each its own route.
import SectionPage from "../../layouts/SectionPage.astro";
import { LANGUAGES, type Language, type Section } from "../../lib/languages";
import { t } from "../../i18n/ui";

export function getStaticPaths() {
  // Astro hoists getStaticPaths out of this file's scope, so the list lives here.
  const empty: Section[] = ["tele", "balados", "art"];
  return LANGUAGES.flatMap((lang) => empty.map((section) => ({ params: { lang, section } })));
}

const lang = Astro.params.lang as Language;
const section = Astro.params.section as Section;
---

<SectionPage lang={lang} section={section} path={`${section}/`}>
  <p class="soon">{t(lang, "comingSoon")}</p>
</SectionPage>
